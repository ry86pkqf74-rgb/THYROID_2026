# Copy to secrets.toml (gitignored) and fill values. Never commit secrets.toml.
# MotherDuck read/write (promotion, validators): SA preferred for automation.
# MD_SA_TOKEN = ""
# MOTHERDUCK_TOKEN = ""
# Optional: primary DB path for local Streamlit (file path or MotherDuck attach).
# LOCAL_DB_PATH = "thyroid_master_local.duckdb"
# Read-scaling / dashboard read-only (never use for writes):
# MD_READ_SCALING_TOKEN = ""
# Or: printf '%s\n' "$MD_READ_SCALING_TOKEN" | .venv/bin/python scripts/merge_streamlit_read_scaling_token.py
# Optional: QUERY_HISTORY attribution (dashboard / automation)
# MOTHERDUCK_CUSTOM_USER_AGENT = "thyroid_dashboard_v1"
# MOTHERDUCK_SESSION_HINT = "streamlit_session_label"
# MD_READ_SCALING_SESSION_HINT = "read_scaling_reader_hint"

title: "THYROID_2026: Thyroid Cancer Research Lakehouse"
type: dataset
authors:
  - family-names: "Glosser"
    given-names: "Logan"
    affiliation: "Emory University"
repository-code: "https://github.com/ry86pkqf74-rgb/THYROID_2026"

# ── Microsoft Fabric / OneLake Credentials ────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is listed in .gitignore.

# Azure Service Principal (Storage Blob Data Contributor on the Lakehouse)
AZURE_TENANT_ID=your-tenant-id-guid
AZURE_CLIENT_ID=your-client-id-guid
AZURE_CLIENT_SECRET=your-client-secret-value

# Microsoft Fabric workspace + lakehouse identifiers
# WORKSPACE_NAME: the display name (e.g. "Thyroid2026")
WORKSPACE_NAME=your-fabric-workspace-name
# FABRIC_LAKEHOUSE_WORKSPACE_ID: the workspace GUID (from Fabric URL)
FABRIC_LAKEHOUSE_WORKSPACE_ID=your-workspace-guid
# LAKEHOUSE_NAME: the Lakehouse display name (e.g. "thyroid_lakehouse")
LAKEHOUSE_NAME=your-lakehouse-name

# OneLake ADLS Gen2 endpoint (default is correct for all Fabric regions)
ONELAKE_ACCOUNT_URL=https://onelake.dfs.core.windows.net

# ── MotherDuck (cloud DuckDB) — optional; see .env.motherduck.example ──
# Read/write for staging loaders, promotion gate, validators (never commit real tokens).
# MOTHERDUCK_TOKEN=md_…           # personal developer token (interactive)
# MD_SA_TOKEN=md_…                # service account / CI (automation)
# MOTHERDUCK_DATABASE=Thyroid 2026   # optional catalog override
# MOTHERDUCK_ENV=prod                  # dev | qa | prod (maps to same DB in repo config today)

# ── Snowflake (snowflake_trial scripts) ────────────────────────────────────
# Programmatic access token from Snowsight (never commit; copy Downloads export into .env only).
# Loaded automatically by snowflake_trial/scripts/_sf_client.py, 02_load_to_snowflake.py, etc.
# SNOWFLAKE_PAT=…

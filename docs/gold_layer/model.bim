      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "string",
            "sourceColumn": "Placeholder"
          }
        ],
        "partitions": [
          {
            "name": "_M_p",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": "let Source = #table({\"Placeholder\"},{{\"\"}})\nin Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Total_Patients",
            "expression": "DISTINCTCOUNT(Dim_Patient[research_id])",
            "displayFolder": "Patients"
          },
          {
            "name": "Mean_Age_At_Surgery",
            "expression": "AVERAGE(Dim_Patient[age_at_surgery])",
            "displayFolder": "Patients"
          },
          {
            "name": "Median_Age_At_Surgery",
            "expression": "MEDIAN(Dim_Patient[age_at_surgery])",
            "displayFolder": "Patients"
          },
          {
            "name": "Pct_Female",
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT(Dim_Patient[research_id]),Dim_Patient[sex]=\"Female\"),[Total_Patients],0)",
            "displayFolder": "Patients"
          },
          {
            "name": "Stage_I_Count",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Outcome[research_id]),Fact_Outcome[overall_stage_ajcc8]=\"I\")",
            "displayFolder": "Staging"
          },
          {
            "name": "Stage_II_Count",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Outcome[research_id]),Fact_Outcome[overall_stage_ajcc8]=\"II\")",
            "displayFolder": "Staging"
          },
          {
            "name": "Stage_III_Count",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Outcome[research_id]),Fact_Outcome[overall_stage_ajcc8]=\"III\")",
            "displayFolder": "Staging"
          },
          {
            "name": "Stage_IV_Count",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Outcome[research_id]),Fact_Outcome[overall_stage_ajcc8]=\"IV\")",
            "displayFolder": "Staging"
          },
          {
            "name": "Pct_Stage_I",
            "expression": "DIVIDE([Stage_I_Count],[Total_Patients],0)",
            "displayFolder": "Staging"
          },
          {
            "name": "Mean_Tumor_Size_cm",
            "expression": "AVERAGE(Fact_Outcome[largest_tumor_cm])",
            "displayFolder": "Pathology"
          },
          {
            "name": "Pct_Multifocal",
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT(Fact_Outcome[research_id]),Fact_Outcome[tumor_focality_overall]=\"Multifocal\"),[Total_Patients],0)",
            "displayFolder": "Pathology"
          },
          {
            "name": "LN_Positivity_Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Fact_Outcome),Fact_Outcome[ln_positive]>0),CALCULATE(COUNTROWS(Fact_Outcome),NOT(ISBLANK(Fact_Outcome[ln_positive]))),0)",
            "displayFolder": "Pathology"
          },
          {
            "name": "Total_Surgical_Episodes",
            "expression": "COUNTROWS(Fact_Treatment)",
            "displayFolder": "Treatment"
          },
          {
            "name": "Pct_Central_Neck_Dissection",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Fact_Treatment),Fact_Treatment[central_neck_dissection_flag]=TRUE()),[Total_Surgical_Episodes],0)",
            "displayFolder": "Treatment"
          },
          {
            "name": "Pct_RLN_Monitoring",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Fact_Treatment),Fact_Treatment[rln_monitoring_flag]=TRUE()),[Total_Surgical_Episodes],0)",
            "displayFolder": "Treatment"
          },
          {
            "name": "Pct_Parathyroid_Autograft",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Fact_Treatment),Fact_Treatment[parathyroid_autograft_flag]=TRUE()),[Total_Surgical_Episodes],0)",
            "displayFolder": "Treatment"
          },
          {
            "name": "Total_FNA_Episodes",
            "expression": "COUNTROWS(Fact_FnaEpisode)",
            "displayFolder": "FNA"
          },
          {
            "name": "Pct_Any_Complication",
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT(Fact_Complications[research_id])),[Total_Patients],0)",
            "displayFolder": "Complications"
          },
          {
            "name": "Patients_With_CT",
            "expression": "DISTINCTCOUNT(Fact_ImagingCT[research_id])",
            "displayFolder": "Imaging"
          },
          {
            "name": "Patients_With_Ultrasound",
            "expression": "DISTINCTCOUNT(Fact_ImagingUS[research_id])",
            "displayFolder": "Imaging"
          },
          {
            "name": "Patients_With_NucMed",
            "expression": "DISTINCTCOUNT(Fact_ImagingNuclear[research_id])",
            "displayFolder": "Imaging"
          },
          {
            "name": "Pct_With_Staging",
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT(Fact_Outcome[research_id]),NOT(ISBLANK(Fact_Outcome[overall_stage_ajcc8]))),[Total_Patients],0)",
            "displayFolder": "DataQuality"
          },
          {
            "name": "Silver_Patient_Count",
            "expression": "DISTINCTCOUNT(Dim_Patient[research_id])",
            "displayFolder": "DataQuality"
          },
          {
            "name": "Pct_With_Op_Note",
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT(Fact_ClinicalNotes[research_id]),NOT(ISBLANK(Fact_ClinicalNotes[opnote_1]))),[Total_Patients],0)",
            "displayFolder": "DataQuality"
          }
        ]
      }

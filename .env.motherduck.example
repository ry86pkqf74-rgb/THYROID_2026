# MotherDuck credentials (copy to .env.motherduck at repo root — gitignored)
# motherduck_client.py loads .env then .env.motherduck at import (python-dotenv, override=False).
# Use env-token auth only; do not pass tokens on the command line in runbooks.
#
# Read/write tokens (staging, promotion, validators):
#   - MOTHERDUCK_TOKEN — personal developer (default priority in get_token())
#   - MD_SA_TOKEN — CI / service account (use prefer_service_account / --sa where supported)
#
# At least one RW token must be set for --md fail-closed scripts, unless tokens live in
# repo-root motherduck.local.toml or .streamlit/secrets.toml (see motherduck_client.py).

# Personal (typical laptop workflow)
# MOTHERDUCK_TOKEN=md_your_token_here

# Automation / GitHub Actions
# MD_SA_TOKEN=md_service_account_token_here

# Logical env → MotherDuck database (defaults from config/motherduck_environments.yml; bump the
# date suffix in that YAML when you create a new dev/qa clone pair — see
# docs/motherduck_sandbox_clone_runbook.md and scripts/130_md_env_bootstrap.py).
#
#   MOTHERDUCK_ENV=dev  → Thyroid 2026 Molecular Dev 20260407
#   MOTHERDUCK_ENV=qa   → Thyroid 2026 Molecular QA 20260407
#   MOTHERDUCK_ENV=prod → Thyroid 2026   (default when unset)
#
# MOTHERDUCK_ENV=prod

# Single-catalog override (wins over MOTHERDUCK_ENV; same behavior as MOTHERDUCK_DB):
# MOTHERDUCK_DATABASE=Thyroid 2026
# MOTHERDUCK_DATABASE=Thyroid 2026 Molecular QA 20260407
# MOTHERDUCK_DATABASE=Thyroid 2026 Molecular Dev 20260407

# Read-scaling / dashboard read-only (never use for promotion or v2_stage loaders)
# MD_READ_SCALING_TOKEN=md_read_scaling_token_here

# Optional: reader session_hint for steadier duckling affinity (dashboard / analysts)
# MD_READ_SCALING_SESSION_HINT=thyroid_dashboard_prod

# Streamlit: try read-scaling token before RW for RO share (default: off)
# MOTHERDUCK_DASHBOARD_PREFER_READ_SCALING_TOKEN=1

# Streamlit: allow primary-catalog attach via connect_read_scaling (default: off)
# MOTHERDUCK_DASHBOARD_ALLOW_READ_SCALING_ATTACH=1

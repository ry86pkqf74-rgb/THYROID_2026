# MotherDuck credentials (copy to .env.motherduck at repo root — gitignored)
# motherduck_client.py loads .env then .env.motherduck at import (python-dotenv, override=False).
# Shell-exported variables win over values in those files (override=False).
# Use env-token auth only; do not pass tokens on the command line in runbooks.
#
# Read/write tokens (staging, promotion, validators) — resolution order matches
# motherduck_client.get_token() / docs/motherduck_database_contract_v1.md §8:
#   1. MD_SA_TOKEN (env), then MOTHERDUCK_TOKEN (env), then motherduck_token (env alias)
#   2. LOCAL_DB_PATH only when it looks like a JWT / md_ PAT (misconfig guard)
#   3. motherduck.local.toml — MD_SA_TOKEN, then MOTHERDUCK_TOKEN, then motherduck_token
#   4. .streamlit/secrets.toml — same TOML key order as (3)
# When both MD_SA_TOKEN and MOTHERDUCK_TOKEN are set (env or same file), MD_SA_TOKEN always wins.
# MD_READ_SCALING_TOKEN is never used as an RW credential (see get_read_scaling_token).
#
# At least one RW token must be set for --md fail-closed scripts, unless tokens live in
# repo-root motherduck.local.toml or .streamlit/secrets.toml (see motherduck_client.py).

# Automation / CI / org service account (wins over personal when both are set)
# MD_SA_TOKEN=md_service_account_token_here

# Personal developer (interactive laptop)
# MOTHERDUCK_TOKEN=md_your_token_here

# Logical env → MotherDuck database (defaults from config/motherduck_environments.yml; bump the
# dev/qa ``database:`` strings in that YAML when you mint a new clone pair — see
# docs/motherduck_sandbox_clone_runbook.md and scripts/130_md_env_bootstrap.py print-env / clone).
#
#   MOTHERDUCK_ENV=dev  → environments.dev.database in YAML (e.g. Thyroid 2026 Molecular Dev 20260407)
#   MOTHERDUCK_ENV=qa   → environments.qa.database (e.g. Thyroid 2026 Molecular QA 20260407)
#   MOTHERDUCK_ENV=prod → environments.prod.database (default: Thyroid 2026)
#
# MOTHERDUCK_ENV=prod

# Single-catalog override (wins over MOTHERDUCK_ENV; MOTHERDUCK_DB is an alias):
# MOTHERDUCK_DATABASE=Thyroid 2026
# MOTHERDUCK_DB=Thyroid 2026 Molecular QA 20260407
# MOTHERDUCK_DATABASE=Thyroid 2026 Molecular Dev 20260407

# Read-scaling / dashboard read-only (never use for promotion or v2_stage loaders)
# MD_READ_SCALING_TOKEN=md_read_scaling_token_here

# Optional: reader session_hint for steadier duckling affinity (dashboard / analysts)
# MD_READ_SCALING_SESSION_HINT=thyroid_dashboard_prod

# Streamlit: try read-scaling token before RW for RO share (default: off)
# MOTHERDUCK_DASHBOARD_PREFER_READ_SCALING_TOKEN=1

# Streamlit: allow primary-catalog attach via connect_read_scaling (default: off)
# MOTHERDUCK_DASHBOARD_ALLOW_READ_SCALING_ATTACH=1
